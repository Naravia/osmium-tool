# Independent expected identity sets plus byte-for-byte source-object checks.
# Missing references are intentional: reference completeness is not the oracle.
cmake_policy(SET CMP0057 NEW)
set(fixture "${source}/tags-filter-bool/input-downward.osm.opl")
execute_process(COMMAND "${osmium}" cat "${fixture}" -f opl
    OUTPUT_VARIABLE canonical ERROR_VARIABLE error RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not read downward fixture: ${error}")
endif()

function(check_depth name expressions depth expected selected)
    set(flags ${ARGN})
    if(NOT depth STREQUAL "default")
        list(APPEND flags "--downward-relation-hops=${depth}")
    endif()
    execute_process(COMMAND "${osmium}" tags-filter-bool "${input}" ${expressions} ${flags} -f opl
        OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT error STREQUAL "")
        message(FATAL_ERROR "${name}: command failed (${result}): ${error}")
    endif()
    string(REPLACE "\n" ";" lines "${canonical}")
    set(expected_output "")
    set(found)
    foreach(line IN LISTS lines)
        if(line MATCHES "^([nwr][0-9]+) ")
            set(id "${CMAKE_MATCH_1}")
            if(id IN_LIST expected)
                list(APPEND found "${id}")
                if(("-t" IN_LIST flags OR "--remove-tags" IN_LIST flags) AND NOT id IN_LIST selected)
                    string(REGEX REPLACE " T[^ ]* " " T " line "${line}")
                endif()
                string(APPEND expected_output "${line}\n")
            endif()
        endif()
    endforeach()
    list(SORT expected)
    list(SORT found)
    if(NOT "${found}" STREQUAL "${expected}" OR NOT output STREQUAL expected_output)
        message(FATAL_ERROR "${name}: expected IDs ${expected} and unchanged source objects (except dependency tags).\nExpected:\n${expected_output}Actual:\n${output}")
    endif()
endfunction()

set(root1 "n1;n2;n3;w10;r20;r21")
set(root2 "n1;n2;n3;n4;n5;w10;w11;r20;r21;r22")
set(root3 "n1;n2;n3;n4;n5;n8;w10;w11;w13;r20;r21;r22;r23")
set(closure "n1;n2;n3;n4;n5;n8;n9;n10;w10;w11;w13;w14;r20;r21;r22;r23")

# Exercise forward references and the reverse relation order, including selected
# nested relations encountered both before and after their selected ancestor.
foreach(order forward reversed)
    set(input "${CMAKE_CURRENT_BINARY_DIR}/downward-${order}.osm.opl")
    if(order STREQUAL "reversed")
        string(REPLACE "\n" ";" lines "${canonical}")
        set(nonrelations "")
        set(relations)
        foreach(line IN LISTS lines)
            if(line MATCHES "^r")
                list(APPEND relations "${line}")
            elseif(NOT line STREQUAL "")
                string(APPEND nonrelations "${line}\n")
            endif()
        endforeach()
        list(REVERSE relations)
        string(REPLACE ";" "\n" relations "${relations}")
        set(canonical "${nonrelations}${relations}\n")
    endif()
    file(WRITE "${input}" "${canonical}")

    check_depth(root-zero "r/root=yes" 0 "r20" "r20")
    check_depth(root-one "r/root=yes" 1 "${root1}" "r20")
    check_depth(root-two "r/root=yes" 2 "${root2}" "r20")
    check_depth(root-three "r/root=yes" 3 "${root3}" "r20")
    check_depth(root-four "r/root=yes" 4 "${closure}" "r20")
    check_depth(cycle-exhaustion "r/root=yes" 50 "${closure}" "r20")
    check_depth(default-recursive "r/root=yes" default "${closure}" "r20")
    check_depth(nested-selected "r/root=yes;r/nested=yes" 1 "${root2}" "r20;r21")
    check_depth(nested-selected-strip "r/root=yes;r/nested=yes" 1 "${root2}" "r20;r21" -t)
    check_depth(nested-selected-zero "r/root=yes;r/nested=yes" 0 "r20;r21" "r20;r21" -t)
    check_depth(selected-way-zero "r/root=yes;w/select=yes" 0 "n6;n7;w12;r20" "w12;r20" -t)
    check_depth(selected-member-way-zero "w/name=direct" 0 "n2;n3;w10" "w10")
    check_depth(selected-member-way "r/root=yes;w/name=direct" 1 "${root1}" "w10;r20" -t)
    check_depth(selected-node "r/root=yes;n/name=label" 1 "${root1}" "n1;r20" -t)
    check_depth(overlapping-paths "r/root" 2 "${root3};r24" "r20;r24" -t)
    check_depth(no-selection "r/absent=yes" 2 "" "")
    check_depth(inverted-selection "nw/NOT select=yes" 0 "n6;n7;w12;r20;r21;r22;r23;r24;r25;r26;r27;r28" "w12;r20;r21;r22;r23;r24;r25;r26;r27;r28" -i -t)

    # Reverse predicates do not restrict the support relation r26. Neither w11
    # nor r26 can seed reverse discovery (which would wrongly add r27).
    set(parents --include-parents --parents-expression=r/parent=yes)
    check_depth(parent-zero "r/root=yes" 0 "r20;r25" "r20;r25" ${parents})
    check_depth(parent-one "r/root=yes" 1 "${root1};r25;r26" "r20;r25" ${parents} -t)
    check_depth(parent-two "r/root=yes" 2 "${root2};n9;n10;w14;r25;r26" "r20;r25" ${parents} -t)
    check_depth(reverse-zero "r/root=yes" 1 "${root1}" "r20" ${parents} --parent-hops=0)
    check_depth(reverse-two "r/root=yes" 1 "${root1};r25;r26;r28" "r20;r25;r28" ${parents} --parent-hops=2 -t)
    check_depth(parent-also-member "r/nested=yes" 1 "${root2}" "r20;r21" ${parents} -t)
    check_depth(parent-unrestricted "r/root=yes" 1 "n1;n2;n3;n8;w10;w13;r20;r21;r22;r23;r25;r26" "r20;r22;r25" --include-parents -t)
endforeach()

# The reverse TSV is independent of downward policy. Compare exact bytes, not
# just its schema, across recursive and bounded materialization.
set(reference_edges "")
foreach(depth default 0 1 2)
    set(edges "${CMAKE_CURRENT_BINARY_DIR}/downward-${depth}.tsv")
    if(depth STREQUAL "default")
        set(expected "${closure};r25;r26;r28")
    elseif(depth EQUAL 0)
        set(expected "r20;r25;r28")
    elseif(depth EQUAL 1)
        set(expected "${root1};r25;r26;r28")
    else()
        set(expected "${root2};n9;n10;w14;r25;r26;r28")
    endif()
    check_depth(edges "r/root=yes" "${depth}" "${expected}" "r20;r25;r28"
        --include-parents --parent-hops=2 --parents-expression=r/parent=yes
        "--parent-relationships=${edges}" -O)
    file(READ "${edges}" relationships)
    if(depth STREQUAL "default")
        set(reference_edges "${relationships}")
    elseif(NOT relationships STREQUAL reference_edges)
        message(FATAL_ERROR "Downward policy changed reverse TSV: ${relationships}")
    endif()
endforeach()
set(expected_edges "child\tparent\trole_percent_escaped\tmember_index\nr20\tr25\tseed\t0\nr25\tr28\tancestor\t0\n")
if(NOT reference_edges STREQUAL expected_edges)
    message(FATAL_ERROR "Unexpected reverse occurrences: ${reference_edges}")
endif()

# At exhaustion bounded and recursive completion must also emit identical PBF
# bytes. Without parents, compare the unchanged default with legacy tags-filter.
foreach(mode normal strip parents parents-strip)
    set(flags)
    if(mode MATCHES "strip$")
        list(APPEND flags -t)
    endif()
    if(mode MATCHES "^parents")
        list(APPEND flags --include-parents --parent-hops=2 --parents-expression=r/parent=yes)
        set(variants default bounded)
    else()
        set(variants default bounded legacy)
    endif()
    foreach(variant IN LISTS variants)
        set(command tags-filter-bool)
        set(extra)
        if(variant STREQUAL "bounded")
            list(APPEND extra --downward-relation-hops=50)
        elseif(variant STREQUAL "legacy")
            set(command tags-filter)
        endif()
        set(pbf "${CMAKE_CURRENT_BINARY_DIR}/downward-${mode}-${variant}.osm.pbf")
        execute_process(COMMAND "${osmium}" "${command}" "${input}" r/root=yes
            ${flags} ${extra} --generator=test -O -o "${pbf}"
            ERROR_VARIABLE error RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "PBF comparison failed: ${error}")
        endif()
        file(SHA256 "${pbf}" hash)
        if(variant STREQUAL "default")
            set(reference_hash "${hash}")
        elseif(NOT hash STREQUAL reference_hash)
            message(FATAL_ERROR "${mode}: ${variant} and default PBF bytes differ")
        endif()
    endforeach()
endforeach()
