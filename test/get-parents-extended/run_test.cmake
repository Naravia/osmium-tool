set(input "${source}/input.osm.opl")
set(output "${CMAKE_CURRENT_BINARY_DIR}/${case}.osm.opl")
set(extra)
list(FIND flags "--parent-hops=1" explicit_one)
if(case MATCHES "edges$" OR NOT explicit_one EQUAL -1)
    set(edges "${CMAKE_CURRENT_BINARY_DIR}/${case}.tsv")
    list(APPEND extra "--parent-relationships=${edges}")
endif()
if(case STREQUAL "seed-osm" OR case STREQUAL "seed-empty")
    set(seeds "${CMAKE_CURRENT_BINARY_DIR}/${case}-seeds.osm.opl")
    if(case STREQUAL "seed-empty")
        file(WRITE "${seeds}" "")
    else()
        execute_process(COMMAND "${osmium}" getid "${input}" ${selection} -f opl -O -o "${seeds}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Could not create seeds")
        endif()
    endif()
    set(selection "-I;${seeds}")
endif()
if(mode STREQUAL "integrated")
    set(command tags-filter-bool --include-parents "${input}" "${selection}")
else()
    set(command get-parents-extended "${input}" ${selection})
endif()
execute_process(COMMAND "${osmium}" ${command} ${flags} ${extra} -f opl -O -o "${output}"
    ERROR_VARIABLE error RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Command failed: ${error}")
endif()
file(READ "${output}" contents)
string(REPLACE "\n" ";" lines "${contents}")
set(actual)
foreach(line IN LISTS lines)
    if(line MATCHES "^([nwr][0-9]+) ")
        list(APPEND actual "${CMAKE_MATCH_1}")
    endif()
endforeach()
if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "Expected ${expected}, got ${actual}:\n${contents}")
endif()
if(case STREQUAL "edges")
    file(READ "${edges}" relationships)
    if(NOT relationships MATCHES "w11\tr20\touter\t0" OR
       NOT relationships MATCHES "n1\tw10\t\t3" OR
       NOT relationships MATCHES "r24\tr25\t\t0")
        message(FATAL_ERROR "Missing roles, occurrences, or typed parent edges: ${relationships}")
    endif()
endif()
if(case STREQUAL "hops-edges")
    file(READ "${edges}" relationships)
    set(expected_edges "child\tparent\trole_percent_escaped\tmember_index\nn6\tw12\t\t2\nn6\tr20\tlabel\t1\nw12\tr22\t\t0\nr20\tr23\t\t0\nr23\tr24\t\t0\nr24\tr25\t\t0\nr25\tr24\t\t1\n")
    if(NOT relationships STREQUAL expected_edges)
        message(FATAL_ERROR "Wrong multi-hop/cycle edges or hop/source order: ${relationships}")
    endif()
endif()
if(NOT explicit_one EQUAL -1)
    list(REMOVE_ITEM flags "--parent-hops=1")
    set(default_output "${CMAKE_CURRENT_BINARY_DIR}/${case}-default.osm.opl")
    set(default_edges "${CMAKE_CURRENT_BINARY_DIR}/${case}-default.tsv")
    execute_process(COMMAND "${osmium}" ${command} ${flags} "--parent-relationships=${default_edges}"
        -f opl -O -o "${default_output}" ERROR_VARIABLE error RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Default hop comparison failed: ${error}")
    endif()
    file(SHA256 "${output}" output_hash)
    file(SHA256 "${default_output}" default_hash)
    file(SHA256 "${edges}" edges_hash)
    file(SHA256 "${default_edges}" default_edges_hash)
    if(NOT output_hash STREQUAL default_hash OR NOT edges_hash STREQUAL default_edges_hash)
        message(FATAL_ERROR "Default and explicit one-hop output/TSV differ")
    endif()
endif()
if(case STREQUAL "hops-zero-edges")
    file(READ "${edges}" relationships)
    if(NOT relationships STREQUAL "child\tparent\trole_percent_escaped\tmember_index\n")
        message(FATAL_ERROR "Zero hops must write only the TSV header: ${relationships}")
    endif()
elseif(case STREQUAL "integrated-hops-edges")
    file(READ "${edges}" relationships)
    set(expected_edges "child\tparent\trole_percent_escaped\tmember_index\nr20\tr23\t\t0\nr23\tr24\t\t0\nr24\tr25\t\t0\nr25\tr24\t\t1\n")
    if(NOT relationships STREQUAL expected_edges)
        message(FATAL_ERROR "Wrong integrated traversal edges: ${relationships}")
    endif()
endif()
if(case STREQUAL "integrated-node-strip")
    if(NOT contents MATCHES "n4 [^\n]* Tkey1=" OR NOT contents MATCHES "n2 [^\n]* T x" OR
       NOT contents MATCHES "w11 [^\n]* Tbuilding=yes N")
        message(FATAL_ERROR "Roots/parents must retain tags and dependencies must lose them")
    endif()
elseif(case STREQUAL "integrated-relation-strip")
    if(NOT contents MATCHES "r23 [^\n]* Ttype=site,group=yes M" OR NOT contents MATCHES "w11 [^\n]* T N")
        message(FATAL_ERROR "Parent relation lost tags or dependency retained them")
    endif()
elseif(case STREQUAL "integrated-cycle-strip")
    if(NOT contents MATCHES "r24 [^\n]* Ttype=site,group=yes,cycle=yes M" OR
       NOT contents MATCHES "r25 [^\n]* Ttype=site M" OR NOT contents MATCHES "r23 [^\n]* T M")
        message(FATAL_ERROR "Cycle dependency provenance or tag removal is wrong")
    endif()
elseif(case STREQUAL "integrated-hops-strip")
    if(NOT contents MATCHES "r23 [^\n]* Ttype=site,group=yes M" OR
       NOT contents MATCHES "r24 [^\n]* Ttype=site,group=yes,cycle=yes M" OR
       NOT contents MATCHES "r25 [^\n]* T M")
        message(FATAL_ERROR "Multi-hop ancestors must retain tags, dependency-only relations must not")
    endif()
endif()
list(FIND flags "-R" omit)
if(mode STREQUAL "integrated" AND omit EQUAL -1)
    execute_process(COMMAND "${osmium}" check-refs -r "${output}" RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Incomplete fixture references: ${error}")
    endif()
endif()
