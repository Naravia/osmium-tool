set(dir "${CMAKE_CURRENT_BINARY_DIR}/parent-errors")
file(MAKE_DIRECTORY "${dir}")
file(WRITE "${dir}/input.osm.opl" "n1 v1 dV c0 t i0 u Tseed=yes x1 y1\nw1 v1 dV c0 t i0 u T Nn1\n")
file(WRITE "${dir}/history.osh" "<?xml version='1.0'?><osm version='0.6'><node id='1' version='1' lat='1' lon='1'/></osm>")
file(WRITE "${dir}/negative.osm.opl" "n-1 v1 dV c0 t i0 u Tseed=yes x1 y1\n")

function(expect_error _name _code)
    execute_process(COMMAND "${osmium}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL _code)
        message(FATAL_ERROR "${_name}: expected error ${_code}, got ${result}: ${error}")
    endif()
endfunction()

expect_error(history 1 get-parents-extended "${dir}/history.osh" n1 -f opl)
expect_error(history-integrated 1 tags-filter-bool "${dir}/history.osh" seed --include-parents -R -f opl)
expect_error(negative-seed 2 get-parents-extended "${dir}/input.osm.opl" -I "${dir}/negative.osm.opl" -f opl)
expect_error(negative-integrated 1 tags-filter-bool "${dir}/negative.osm.opl" seed --include-parents -R -f opl)
expect_error(alias-source 2 get-parents-extended "${dir}/input.osm.opl" n1 -O -o "${dir}/input.osm.opl")
expect_error(alias-integrated 2 tags-filter-bool "${dir}/input.osm.opl" seed --include-parents -O -o "${dir}/input.osm.opl")
expect_error(alias-sidecar 2 get-parents-extended "${dir}/input.osm.opl" n1 -O --parent-relationships "${dir}/input.osm.opl" -f opl)
file(READ "${dir}/input.osm.opl" input)
if(NOT input MATCHES "seed=yes")
    message(FATAL_ERROR "Output-path rejection damaged an input")
endif()
file(WRITE "${dir}/edges.tsv" "untouched\n")
expect_error(existing-sidecar 2 get-parents-extended "${dir}/input.osm.opl" n1 --parent-relationships "${dir}/edges.tsv" -f opl)
file(READ "${dir}/edges.tsv" edges)
if(NOT edges STREQUAL "untouched\n")
    message(FATAL_ERROR "Existing sidecar was overwritten without permission")
endif()
expect_error(stdout-sidecar 2 get-parents-extended "${dir}/input.osm.opl" n1 --parent-relationships=- -f opl)
foreach(hops -1 +1 1.5 bad 184467440737095516160)
    expect_error(invalid-hops 2 get-parents-extended "${dir}/input.osm.opl" n1 "--parent-hops=${hops}" -f opl)
    expect_error(invalid-integrated-hops 2 tags-filter-bool "${dir}/input.osm.opl" seed --include-parents "--parent-hops=${hops}" -f opl)
endforeach()
expect_error(hops-opt-in 2 tags-filter-bool "${dir}/input.osm.opl" seed --parent-hops=1 -R -f opl)
expect_error(hops-stdin 2 get-parents-extended - n1 -F opl --parent-hops=2 -f opl)

execute_process(COMMAND "${osmium}" get-parents-extended -F opl - n1 -f opl
    INPUT_FILE "${dir}/input.osm.opl" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "^w1 ")
    message(FATAL_ERROR "Standalone source STDIN failed: ${error}${output}")
endif()
execute_process(COMMAND "${osmium}" get-parents-extended -F opl - n1 --parent-hops=0 -s -f opl
    INPUT_FILE "${dir}/input.osm.opl" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "^n1 " OR output MATCHES "w1 ")
    message(FATAL_ERROR "Standalone zero-hop source STDIN failed: ${error}${output}")
endif()
